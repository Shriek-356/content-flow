# Server Configuration
PORT=3001
BASE_URL=http://localhost:3001

# Google Cloud (Sheets & Drive API)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Content Selector
GOOGLE_PUBLISH_SHEET_NAME=Publish Content
GOOGLE_SHEET_GID=2121812891
GOOGLE_PUBLISH_SHEET_GID=743957638
GOOGLE_SHEET_DATA_START_ROW=5
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_API_KEY=your_google_api_key_optional

# Buffer API & Channels
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here
ORGANIZATION_ID=your_buffer_org_id_optional
BUFFER_TIKTOK_CHANNEL_ID=your_tiktok_channel_id
BUFFER_FB_PAGE_CHANNEL_ID=your_fb_page_channel_id
BUFFER_FB_GROUP_CHANNEL_ID=your_fb_group_channel_id

# n8n Orchestrator
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here
N8N_WORKFLOW_ID=your_n8n_workflow_id_here

# TikTok Developer App (Optional - for Direct API)
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_REDIRECT_URI=http://localhost:3001/tiktok/callback

# Cloudinary (Optional - for media hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret